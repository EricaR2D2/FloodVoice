# Public Health MVP - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it's in .gitignore for security

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_new_openrouter_api_key_here

# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Database Configuration (optional)
DATABASE_PATH=public_health_data.db

# Deployment Configuration
PORT=5000

# Email/Notification Settings (optional)
NOTIFICATION_EMAIL=your_email@example.com

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual API keys
# 3. Never commit .env to git
# 4. For deployment, set these as environment variables in your hosting platform
