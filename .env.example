# FloodVoice Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it's in .gitignore for security

# Flask Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True

# Database
DATABASE_PATH=floodvoice.db

# FloodNet API
# Get API access from https://dataviz.floodnet.nyc/
FLOODNET_API_URL=https://api.floodnet.nyc/sensors
FLOODNET_API_KEY=your_floodnet_api_key_here
FLOODNET_UPDATE_INTERVAL=300

# OpenRouter API (for AI insights)
# Get API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NYC GeoClient API (for geocoding)
# Get credentials from https://developer.cityofnewyork.us/
NYC_GEOCLIENT_APP_ID=your_geoclient_app_id_here
NYC_GEOCLIENT_APP_KEY=your_geoclient_app_key_here

# Social Media APIs (optional)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# Alert Thresholds (inches)
MINOR_FLOOD_THRESHOLD=2.0
MODERATE_FLOOD_THRESHOLD=6.0
MAJOR_FLOOD_THRESHOLD=12.0

# Correlation Settings
MAX_CORRELATION_DISTANCE_MILES=1.0
CORRELATION_TIME_WINDOW_HOURS=2

# Demo Mode
DEMO_MODE=True
USE_MOCK_DATA=True

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual API keys
# 3. Never commit .env to git
# 4. For deployment, set these as environment variables in your hosting platform
